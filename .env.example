# Copy to .env. Never commit .env.
PLOTWARD_API_KEY=change-me
POSTGRES_PASSWORD=plotward
PLOTWARD_GARDEN_NAME=My garden
PLOTWARD_GARDEN_TIMEZONE=America/Los_Angeles
# Where uploaded photos are stored on your machine (Docker). Defaults to ~/plotward-data.
# Back this folder up along with the database.
# PLOTWARD_DATA_HOST_DIR=/Users/you/plotward-data

# Embedding model for the worker: open_clip (real, downloads ~600 MB on first start) or
# histogram (color-only stand-in, for quick tests).
# PLOTWARD_EMBEDDER=open_clip

# Local development outside Docker
PLOTWARD_DATABASE_URL=postgresql+psycopg://plotward:plotward@localhost:5432/plotward
PLOTWARD_DATA_DIR=./data
